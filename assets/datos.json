Future<void> cargarDatosDesdeWeb() async {
  // 1. Apuntamos a la URL de JSONPlaceholder
  final url = Uri.parse('https://jsonplaceholder.typicode.com/todos');

  try {
  // 2. Hacemos la petición a internet
  final respuesta = await http.get(url);

  // 3. El código 200 significa que el servidor web respondió con éxito
  if (respuesta.statusCode == 200) {
  // Convertimos el texto de la web en una lista real de Dart
  final List<dynamic> datosWeb = jsonDecode(respuesta.body);

  setState(() {
  miListaEstructura.clear(); // Limpiamos la Pila/Cola previa
  miListaEstructura.addAll(datosWeb); // Guardamos las 200 tareas nuevas
});

print("¡Éxito! Datos sincronizados con la API de internet.");
} else {
print("Error del servidor: ${respuesta.statusCode}");
}
} catch (e) {
print("Error de red (revisa si tienes WiFi): $e");
}
}